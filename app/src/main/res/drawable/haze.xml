<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Równomierne przyciemnienie + mocniejsze na dole pod dokiem i w strefie zegara -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#2E000000" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="90" android:startColor="#C7000000" android:centerColor="#4D000000" android:endColor="#14000000" android:type="linear" />
        </shape>
    </item>
</layer-list>
