<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="420dp"
    android:clipChildren="true"
    android:focusable="false">

    <!-- Nagłówek: rozstrzelony podtytuł, duży cienki tytuł, zdanie -->
    <LinearLayout
        android:id="@+id/hero_text"
        android:layout_width="560dp"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="12dp"
        android:layout_marginTop="36dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/hero_eyebrow"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.42"
            android:textAllCaps="true"
            android:textColor="@color/text_soft"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hero_title"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="14"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-light"
            android:letterSpacing="-0.02"
            android:lineSpacingMultiplier="0.92"
            android:maxLines="2"
            android:textColor="@color/text"
            android:textSize="62sp" />

        <TextView
            android:id="@+id/hero_subtitle"
            android:shadowColor="#CCFFFFFF"
            android:shadowRadius="14"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_soft"
            android:textSize="15sp" />
    </LinearLayout>

    <!-- Karta dolna-lewa: Ostatnio otwierane -->
    <LinearLayout
        android:id="@+id/hero_recent"
        android:layout_width="400dp"
        android:layout_height="190dp"
        android:layout_gravity="start|bottom"
        android:layout_marginStart="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/glass_card"
        android:elevation="6dp"
        android:orientation="horizontal"
        android:padding="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.3"
                android:text="@string/card_recent_eyebrow"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="9sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingMultiplier="0.95"
                android:text="@string/card_recent_title"
                android:textColor="@color/text"
                android:textSize="19sp" />

            <TextView
                android:id="@+id/recent_lines"
                android:layout_width="wrap_content"
                android:layout_height="0dp"
                android:layout_marginTop="6dp"
                android:layout_weight="1"
                android:lineSpacingMultiplier="1.15"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/card_recent_cta"
                    android:textColor="@color/text"
                    android:textSize="12sp" />

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/circle_ink">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_arrow_ne" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <ImageView
            android:id="@+id/recent_image"
            android:layout_width="118dp"
            android:layout_height="match_parent"
            android:background="@drawable/poster_bg"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <!-- Karta dolna-prawa: wybrana aplikacja -->
    <LinearLayout
        android:id="@+id/hero_poster"
        android:layout_width="340dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/glass_card"
        android:elevation="6dp"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="18dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/hero_card_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <ImageView
                android:id="@+id/hero_poster_image"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:background="@drawable/poster_bg"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />
        </LinearLayout>

        <TextView
            android:id="@+id/hero_card_sub"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/hero_card_desc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:lineSpacingMultiplier="1.15"
            android:textColor="@color/text_soft"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/stat_fav"
                layout="@layout/card_stat" />

            <include
                android:id="@+id/stat_time"
                layout="@layout/card_stat" />

            <include
                android:id="@+id/stat_kind"
                layout="@layout/card_stat" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/card_open"
                android:textColor="@color/text"
                android:textSize="22sp" />

            <FrameLayout
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/circle_ink">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_ne" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
