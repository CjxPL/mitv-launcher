<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ImageView
        android:id="@+id/backdrop_a"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <ImageView
        android:id="@+id/backdrop_b"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:importantForAccessibility="no"
        android:scaleType="centerCrop" />

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/haze" />

    <!-- Środek: zegar, pogoda teraz, prognoza 7 dni -->
    <LinearLayout
        android:id="@+id/center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginBottom="40dp"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-thin"
            android:includeFontPadding="false"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowRadius="18"
            android:textColor="@color/text"
            android:textSize="150sp" />

        <TextView
            android:id="@+id/date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:letterSpacing="0.3"
            android:shadowColor="#80000000"
            android:shadowRadius="10"
            android:textAllCaps="true"
            android:textColor="@color/text_soft"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/weather_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no" />

            <TextView
                android:id="@+id/weather_temp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:fontFamily="sans-serif-thin"
                android:includeFontPadding="false"
                android:shadowColor="#80000000"
                android:shadowRadius="10"
                android:textColor="@color/text"
                android:textSize="44sp" />

            <TextView
                android:id="@+id/weather_desc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#80000000"
                android:shadowRadius="10"
                android:textColor="@color/text"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/weather_extra"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="18dp"
                android:fontFamily="sans-serif-light"
                android:shadowColor="#80000000"
                android:shadowRadius="10"
                android:textColor="@color/text_muted"
                android:textSize="16sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/forecast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:orientation="horizontal" />
    </LinearLayout>

    <!-- Podpis zaznaczonej aplikacji nad dokiem -->
    <TextView
        android:id="@+id/dock_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="108dp"
        android:alpha="0"
        android:letterSpacing="0.2"
        android:shadowColor="#80000000"
        android:shadowRadius="10"
        android:textAllCaps="true"
        android:textColor="@color/text_soft"
        android:textSize="12sp" />

    <!-- Dok-karuzela na dole: zaznaczona ikona zawsze na środku -->
    <pl.fouroptima.mitvlauncher.DockView
        android:id="@+id/dock"
        android:layout_width="match_parent"
        android:layout_height="88dp"
        android:layout_gravity="bottom"
        android:layout_marginBottom="22dp"
        android:clipChildren="false" />

    <!-- Wszystkie aplikacje (nakładka) -->
    <FrameLayout
        android:id="@+id/apps_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/overlay_bg"
        android:elevation="20dp"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="56dp"
            android:paddingTop="40dp"
            android:paddingEnd="56dp"
            android:paddingBottom="40dp" />
    </FrameLayout>

    <View
        android:id="@+id/panel_scrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0"
        android:background="#66000000"
        android:elevation="22dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/side_panel"
        android:layout_width="360dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/panel_bg"
        android:elevation="24dp"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="40dp"
        android:paddingEnd="22dp"
        android:paddingBottom="28dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.28"
            android:paddingStart="18dp"
            android:text="@string/panel_title"
            android:textAllCaps="true"
            android:textColor="@color/text_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/panel_rows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="14dp"
            android:layout_weight="1"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/panel_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="18dp"
            android:textColor="@color/neutral"
            android:textSize="12sp" />
    </LinearLayout>
</FrameLayout>
