<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161616">

    <!-- Ekran jak we wzorze: zaokrąglona rama na ciemnym tle -->
    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="18dp"
        android:background="@drawable/frame_bg">

        <ImageView
            android:id="@+id/backdrop_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/backdrop_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/haze" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/haze_left" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="112dp"
            android:paddingTop="92dp"
            android:paddingEnd="34dp"
            android:paddingBottom="40dp" />

        <!-- Góra jak we wzorze: osobne pigułki po bokach, zakładka z polami zwisająca ze środka górnej krawędzi -->
        <FrameLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="80dp"
            android:clipChildren="false"
            android:elevation="6dp">

            <LinearLayout
                android:id="@+id/top_apps"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="22dp"
                android:background="@drawable/pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_nw" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/top_apps"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal|top"
                android:background="@drawable/topband_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="30dp"
                android:paddingEnd="30dp">

                <include
                    android:id="@+id/field_weather"
                    layout="@layout/top_field" />

                <include
                    android:id="@+id/field_place"
                    layout="@layout/top_field" />

                <include
                    android:id="@+id/field_time"
                    layout="@layout/top_field" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/top_more"
                android:layout_width="150dp"
                android:layout_height="44dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="22dp"
                android:background="@drawable/pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/panel_title"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_ne_ink" />
            </LinearLayout>
        </FrameLayout>

        <!-- Lewy pasek: okrągłe szklane przyciski -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start|top"
            android:layout_marginStart="22dp"
            android:layout_marginTop="92dp"
            android:layout_marginBottom="150dp"
            android:background="@drawable/railpill_bg"
            android:elevation="10dp"
            android:gravity="center_horizontal|top"
            android:orientation="vertical"
            android:paddingStart="7dp"
            android:paddingTop="10dp"
            android:paddingEnd="7dp"
            android:paddingBottom="10dp">

            <LinearLayout
                android:id="@+id/rail_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="22dp"
                android:layout_height="1dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="8dp"
                android:background="#33000000" />

            <LinearLayout
                android:id="@+id/rail_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:id="@+id/panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#55000000"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/side_panel"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/panel_bg"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="40dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.28"
                android:paddingStart="18dp"
                android:text="@string/panel_title"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/panel_rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/panel_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:textColor="@color/neutral"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
