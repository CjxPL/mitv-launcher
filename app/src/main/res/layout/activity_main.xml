<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#161616">

    <!-- Ekran jak we wzorze: zaokrąglona rama na ciemnym tle -->
    <FrameLayout
        android:id="@+id/frame"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_margin="18dp"
        android:background="@drawable/frame_bg">

        <ImageView
            android:id="@+id/backdrop_a"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/backdrop_b"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:importantForAccessibility="no"
            android:scaleType="centerCrop" />

        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/haze" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="108dp"
            android:paddingTop="92dp"
            android:paddingEnd="34dp"
            android:paddingBottom="40dp" />

        <!-- Górny pasek: pigułka z lewej, trzy pola w środku, pigułka z prawej -->
        <LinearLayout
            android:id="@+id/topbar"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginTop="18dp"
            android:layout_marginEnd="24dp"
            android:background="@drawable/glass_pill"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="8dp"
            android:paddingEnd="8dp">

            <LinearLayout
                android:id="@+id/top_apps"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:background="@drawable/pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_nw" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/top_apps"
                    android:textColor="@color/text"
                    android:textSize="13sp" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/field_weather"
                layout="@layout/top_field" />

            <include
                android:id="@+id/field_place"
                layout="@layout/top_field" />

            <include
                android:id="@+id/field_time"
                layout="@layout/top_field" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <LinearLayout
                android:id="@+id/top_more"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:background="@drawable/pill_white"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="14dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:text="@string/panel_title"
                    android:textColor="@color/text"
                    android:textSize="13sp" />

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_arrow_ne_ink" />
            </LinearLayout>
        </LinearLayout>

        <!-- Lewy pasek: okrągłe szklane przyciski -->
        <LinearLayout
            android:id="@+id/rail"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:elevation="10dp"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingStart="30dp"
            android:paddingTop="90dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/rail_items"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <View
                android:layout_width="24dp"
                android:layout_height="1dp"
                android:layout_marginStart="13dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="14dp"
                android:background="#44000000" />

            <LinearLayout
                android:id="@+id/rail_bottom"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <View
            android:id="@+id/panel_scrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="#55000000"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/side_panel"
            android:layout_width="360dp"
            android:layout_height="match_parent"
            android:layout_gravity="end"
            android:background="@drawable/panel_bg"
            android:elevation="24dp"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="40dp"
            android:paddingEnd="22dp"
            android:paddingBottom="28dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.28"
                android:paddingStart="18dp"
                android:text="@string/panel_title"
                android:textAllCaps="true"
                android:textColor="@color/text_muted"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/panel_rows"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/panel_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="18dp"
                android:textColor="@color/neutral"
                android:textSize="12sp" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
